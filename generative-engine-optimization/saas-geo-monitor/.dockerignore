# Docker ignore file
# Excludes unnecessary files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment files
.env
.env.local
.env.*.local
*.env

# Database
*.db
*.sqlite
*.sqlite3
geo_dev.db

# Logs
*.log
logs/

# Test files
test_*.py
*_test.py
tests/

# Results
results/
*.html
*.json
*.md
*.txt

# Documentation (not needed in container)
*.md
!README.md
docs/

# Git
.git/
.gitignore

# OS
.DS_Store
Thumbs.db

# Docker
.dockerignore
docker-compose*.yml
Dockerfile*

# CI/CD
.github/
.gitlab-ci.yml

# Temporary files
*.tmp
*.bak
*.swp

